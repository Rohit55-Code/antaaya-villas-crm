# Uploaded lead documents (KYC, agreements…) — never served directly.
# They're only reachable through api/client_documents.php, which checks the login.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
